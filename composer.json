{
    "name": "bmkg/solar-energy-dashboard",
    "type": "project",
    "description": "Solar Energy Monitoring System Dashboard (50Wp/100Wp) with Laravel 11, Google Sheets API & Chart.js",
    "keywords": ["laravel", "solar-energy", "google-sheets-api", "iot", "esp32"],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "laravel/framework": "^11.0",
        "revolution/laravel-google-sheets": "^7.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
